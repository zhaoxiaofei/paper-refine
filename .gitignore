# ignore data from third-party
audit_data/

# ignore debugging info, which can be huge)
debug_runs/

# Local agent/file-bridge runtime state (SQLite database and WAL companions).
agent-file-bridge.sqlite3*

# `media/` commits the PNG figures the docs embed (README.md, AGENT.md, ...); a
# local `.pdf` render beside them is NOT ignored (it shows in `git status` until
# it is deleted or explicitly ignored).

# The README quickstart's own run root (`./paper_rounds`) is output, not source.
paper_rounds/

# ignore temporary directories and files. `tmp/` alone missed the shape the
# debug rounds actually create: `tempfile.mkdtemp(prefix="tmp")` in the
# repository root emits `tmp<8 random characters>/` (no slash), so three of
# them were swept into the tree by a `git add`. The glob covers both.
tmp*/

# Windows/WSL "downloaded from the internet" marker files (`name:Zone.Identifier`)
*:Zone.Identifier

# Python bytecode from running the .paper_test/ and paper-skills/tests/ harnesses
__pycache__/
*.pyc
# `.paper_test/run_all.py --logs` may keep its per-suite logs inside the tree
.paper_test/logs/

# Node dependencies of mcp-docx-converter/: installed from its package-lock.json
# (`npm ci` inside mcp-docx-converter/), never vendored into the repository.
node_modules/

# Venue profiles: the JSON profiles and the README are curated, shipped content
# (a root resolves its venue from them), so they stay trackable. Everything an
# `add-venue` run DOWNLOADS or DERIVES is local data and stays out of the repo:
#   <id>.official/                  the journal's own template files
#   <id>.manuscripts/               downloaded OA articles / transcriptions
#   <id>.templates/                 the generated structure-only pack
#   <id>.manually-created-official/ hand-collected template copies
#   .add-venue/                     agent scratch (prompts, logs, staged store)
venue_profiles/*
!venue_profiles/README.md
!venue_profiles/*.json

# Office owner/lock files ("~$name.xlsx", "~$name.docx") appear whenever a
# workbook or document is open; is_non_shippable_name() treats both as junk.
~$*.xlsx
~$*.docx
~$*.doc
