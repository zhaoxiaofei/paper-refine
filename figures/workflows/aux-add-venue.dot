digraph workflow {
graph [rankdir=TB, bgcolor="white", pad=0.18, nodesep=0.24, ranksep=0.33, fontname="DejaVu Sans", fontsize=15, labelloc=t, label="Auxiliary workflow: add or update a venue profile"];
node [shape=box, style="rounded,filled", color="#475569", penwidth=0.8, fontname="DejaVu Sans", fontsize=10, margin="0.14,0.08"];
edge [color="#475569", arrowsize=0.65, fontname="DejaVu Sans", fontsize=8];
evidence [label="Authoritative venue evidence + existing store\nread-only", fillcolor="#F1F5F9"];
profile [label="Venue profile writer\nstaged profile + README + downloads", fillcolor="#DBEAFE"];
profile_audit [label="Independent write auditor", fillcolor="#DCFCE7"];
profile_repair [label="Bounded repair\nreverify every planned row", fillcolor="#DBEAFE"];
profile_verify [label="Independent final verifier", fillcolor="#DCFCE7"];
profile_accept [label="Code checks + exact-byte acceptance", fillcolor="#FEF3C7"];
profile -> profile_audit [label=""];
profile_audit -> profile_repair [label="repairable rows"];
profile_repair -> profile_verify [label=""];
profile_audit -> profile_accept [label="empty plan"];
profile_verify -> profile_accept [label="passes"];
evidence -> profile [label=""];
schema [label="Code schema validation + publication\nonly the audited staged store", fillcolor="#F1F5F9"];
profile_accept -> schema [label=""];
}
