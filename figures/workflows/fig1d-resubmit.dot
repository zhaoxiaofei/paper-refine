digraph workflow {
graph [rankdir=TB, bgcolor="white", pad=0.18, nodesep=0.24, ranksep=0.33, fontname="DejaVu Sans", fontsize=15, labelloc=t, label="(d) Resubmit to the same journal"];
node [shape=box, style="rounded,filled", color="#475569", penwidth=0.8, fontname="DejaVu Sans", fontsize=10, margin="0.14,0.08"];
edge [color="#475569", arrowsize=0.65, fontname="DejaVu Sans", fontsize=8];
source [label="Original manuscript + read-only evidence", fillcolor="#F1F5F9"];
feedback [label="Prior journal / permitted LLM feedback", fillcolor="#F1F5F9"];
assessor [label="Feedback assessor\nread/report only", fillcolor="#DCFCE7"];
feedback -> assessor [label=""];
guided [label="Guided reviewer", fillcolor="#DCFCE7"];
cold [label="Cold-start reviewer\nwhen enabled and full scope", fillcolor="#DCFCE7"];
findings [label="Frozen findings\noptional read-only review auditor", fillcolor="#DCFCE7"];
rewrite [label="Rewriter(s)\noptional; exempt from write audit", fillcolor="#DBEAFE"];
source -> guided [label=""];
source -> cold [label=""];
source -> rewrite [label="", style=dashed];
assessor -> guided [label=""];
assessor -> rewrite [label="", style=dashed];
guided -> findings [label=""];
cold -> findings [label=""];
revise [label="Reviser(s)", fillcolor="#DBEAFE"];
revise_audit [label="Independent write auditor", fillcolor="#DCFCE7"];
revise_repair [label="Bounded repair\nreverify every planned row", fillcolor="#DBEAFE"];
revise_verify [label="Independent final verifier", fillcolor="#DCFCE7"];
revise_accept [label="Code checks + exact-byte acceptance", fillcolor="#FEF3C7"];
revise -> revise_audit [label=""];
revise_audit -> revise_repair [label="repairable rows"];
revise_repair -> revise_verify [label=""];
revise_audit -> revise_verify [label="empty plan"];
revise_verify -> revise_accept [label="passes"];
findings -> revise [label=""];
source -> revise [label=""];
pool [label="Candidate pool\nbase + rewrites + accepted revisions", fillcolor="#F1F5F9"];
source -> pool [label=""];
rewrite -> pool [label="", style=dashed];
revise_accept -> pool [label=""];
integrate [label="Integrator(s)\noptional; exempt from write audit", fillcolor="#DBEAFE"];
field [label="Candidate field + prior champions", fillcolor="#F1F5F9"];
pool -> integrate [label="whole pool", style=dashed];
pool -> field [label=""];
integrate -> field [label="", style=dashed];
judges [label="Independent judge sessions", fillcolor="#DCFCE7"];
diagnostics [label="Panel conflict / defect auditors\noptional diagnostics", fillcolor="#DCFCE7"];
selection [label="Code selection + pin\nrepeat round if scheduled", fillcolor="#F1F5F9"];
field -> judges [label=""];
judges -> selection [label=""];
judges -> diagnostics [label="", style=dashed];
field -> selection [label="auto-promotion option\nprovisional; no panel", style=dashed];
response [label="Response writer\nletter + concern map", fillcolor="#DBEAFE"];
response_audit [label="Independent write auditor", fillcolor="#DCFCE7"];
response_repair [label="Bounded repair\nreverify every planned row", fillcolor="#DBEAFE"];
response_verify [label="Independent final verifier", fillcolor="#DCFCE7"];
response_accept [label="Code checks + exact-byte acceptance", fillcolor="#FEF3C7"];
response -> response_audit [label=""];
response_audit -> response_repair [label="repairable rows"];
response_repair -> response_verify [label=""];
response_audit -> response_accept [label="empty plan"];
response_verify -> response_accept [label="passes"];
selection -> response [label="final manuscript"];
assessor -> response [label="concern ledger"];
output [label="Code publication\njournal submission + response", fillcolor="#F1F5F9"];
selection -> output [label=""];
response_accept -> output [label=""];
}
